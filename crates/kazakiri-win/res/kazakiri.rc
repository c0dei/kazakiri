#include <winver.h>
#define RT_MANIFEST 24
#define CREATEPROCESS_MANIFEST_RESOURCE_ID 1

1 ICON "kazakiri.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "kazakiri.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @VERSION_COMMA@
PRODUCTVERSION @VERSION_COMMA@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041104b0"
    BEGIN
      VALUE "CompanyName", "kazakiri project"
      VALUE "FileDescription", "kazakiri text editor"
      VALUE "FileVersion", "@VERSION_STR@"
      VALUE "InternalName", "kazakiri"
      VALUE "LegalCopyright", "MIT OR Apache-2.0"
      VALUE "OriginalFilename", "kazakiri.exe"
      VALUE "ProductName", "kazakiri"
      VALUE "ProductVersion", "@VERSION_STR@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x411, 1200
  END
END
